<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <!-- Default Steam paths by platform -->
    <RimWorldPath Condition="'$(RimWorldPath)' == '' and '$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))'">D:\Games\Steam\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;)) and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/RimWorld')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))">$(HOME)/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and '$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))'">D:\Games\Steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;)) and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
    <!-- Fallback to repository reference assemblies if local game path or harmony does not exist -->
    <RimWorldResolvedPath Condition="Exists('$(RimWorldPath)/Assembly-CSharp.dll')">$(RimWorldPath)</RimWorldResolvedPath>
    <RimWorldResolvedPath Condition="'$(RimWorldResolvedPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../../lib/ref/Assembly-CSharp.dll')">$(MSBuildThisFileDirectory)../../../lib/ref</RimWorldResolvedPath>
    <RimWorldResolvedPath Condition="'$(RimWorldResolvedPath)' == ''">$(RimWorldPath)</RimWorldResolvedPath>
    <HarmonyResolvedPath Condition="Exists('$(HarmonyPath)')">$(HarmonyPath)</HarmonyResolvedPath>
    <HarmonyResolvedPath Condition="'$(HarmonyResolvedPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../../lib/ref/0Harmony.dll')">$(MSBuildThisFileDirectory)../../../lib/ref/0Harmony.dll</HarmonyResolvedPath>
    <HarmonyResolvedPath Condition="'$(HarmonyResolvedPath)' == ''">$(HarmonyPath)</HarmonyResolvedPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyResolvedPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldResolvedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(RimWorldResolvedPath)/RimWorld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldResolvedPath)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldResolvedPath)/Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(RimWorldResolvedPath)/CommunityToolkit.HighPerformance.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Geoscape.Tests" />
  </ItemGroup>

  <Target Name="GenerateBuildMetadata" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'"))</BuildTimestamp>
      <BuildInfoFile>$(IntermediateOutputPath)BuildMetadata.g.cs</BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <BuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <BuildInfoLines Include="namespace ProjectVigilance.Geoscape%3b" />
      <BuildInfoLines Include="internal static class BuildInfo" />
      <BuildInfoLines Include="{" />
      <BuildInfoLines Include="    public const string BuildDate = &quot;$(BuildTimestamp)&quot;%3b" />
      <BuildInfoLines Include="    public const string Configuration = &quot;$(Configuration)&quot;%3b" />
      <BuildInfoLines Include="    public const string Version = &quot;$(Version)&quot;%3b" />
      <BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <Target Name="RotateLockedAssembly" BeforeTargets="BeforeBuild">
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="cmd /c if exist &quot;$(OutputPath)Geoscape.dll&quot; (del /f /q &quot;$(OutputPath)Geoscape.dll.old&quot; 2&gt;nul &amp; move /y &quot;$(OutputPath)Geoscape.dll&quot; &quot;$(OutputPath)Geoscape.dll.old&quot; 2&gt;nul &amp; exit 0)" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="if [ -f &quot;$(OutputPath)Geoscape.dll&quot; ]; then rm -f &quot;$(OutputPath)Geoscape.dll.old&quot; 2&gt;/dev/null; mv &quot;$(OutputPath)Geoscape.dll&quot; &quot;$(OutputPath)Geoscape.dll.old&quot; 2&gt;/dev/null || true; fi" />
  </Target>

  <Target Name="StageCleanDistribution" AfterTargets="Build">
    <PropertyGroup>
      <ModRootDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../..'))</ModRootDir>
      <RepoRootDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../../..'))</RepoRootDir>
      <CleanStagingDir>$([MSBuild]::NormalizeDirectory('$(RepoRootDir)dist/ProjectVigilance-OverlandIncursions'))</CleanStagingDir>
    </PropertyGroup>

    <!-- Clean unlocked .old assembly backups and rotate locked staged DLL if RimWorld is running -->
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="cmd /c (del /f /q &quot;$(OutputPath)Geoscape.dll.old&quot; 2&gt;nul &amp; if exist &quot;$(CleanStagingDir)1.7\Assemblies\Geoscape.dll&quot; (del /f /q &quot;$(CleanStagingDir)1.7\Assemblies\Geoscape.dll.old&quot; 2&gt;nul &amp; move /y &quot;$(CleanStagingDir)1.7\Assemblies\Geoscape.dll&quot; &quot;$(CleanStagingDir)1.7\Assemblies\Geoscape.dll.old&quot; 2&gt;nul) &amp; exit 0)" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="rm -f &quot;$(OutputPath)Geoscape.dll.old&quot; &quot;$(CleanStagingDir)1.7/Assemblies/Geoscape.dll.old&quot; &quot;$(CleanStagingDir)1.7/Assemblies/Geoscape.dll&quot; 2&gt;/dev/null || true" />

    <!-- Preserve Workshop ID generated/updated in clean staging back into the mod source tree -->
    <Copy SourceFiles="$(CleanStagingDir)About/PublishedFileId.txt"
          DestinationFiles="$(ModRootDir)About/PublishedFileId.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CleanStagingDir)About/PublishedFileId.txt')" />

    <ItemGroup>
      <_StagingAbout Include="$(ModRootDir)About/About.xml" Condition="Exists('$(ModRootDir)About/About.xml')" />
      <_StagingAbout Include="$(ModRootDir)About/Preview.png" Condition="Exists('$(ModRootDir)About/Preview.png')" />
      <_StagingAbout Include="$(ModRootDir)About/Icon.png" Condition="Exists('$(ModRootDir)About/Icon.png')" />
      <_StagingAbout Include="$(ModRootDir)About/ModIcon.png" Condition="Exists('$(ModRootDir)About/ModIcon.png')" />
      <_StagingAbout Include="$(ModRootDir)About/PublishedFileId.txt" Condition="Exists('$(ModRootDir)About/PublishedFileId.txt')" />

      <_StagingAssemblies Include="$(OutputPath)Geoscape.dll" Condition="Exists('$(OutputPath)Geoscape.dll')" />
      <_StagingAssemblies Include="$(OutputPath)Geoscape.pdb" Condition="Exists('$(OutputPath)Geoscape.pdb')" />

      <_StagingDefs Include="$(ModRootDir)1.7/Defs/**/*" Condition="Exists('$(ModRootDir)1.7/Defs')" />
      <_StagingPatches Include="$(ModRootDir)1.7/Patches/**/*" Condition="Exists('$(ModRootDir)1.7/Patches')" />
      <_StagingTextures Include="$(ModRootDir)1.7/Textures/**/*" Condition="Exists('$(ModRootDir)1.7/Textures')" />
      <_StagingLanguages Include="$(ModRootDir)1.7/Languages/**/*" Condition="Exists('$(ModRootDir)1.7/Languages')" />

      <_StagingDocs Include="$(RepoRootDir)LICENSE" Condition="Exists('$(RepoRootDir)LICENSE')" />
      <_StagingDocs Include="$(ModRootDir)README.md" Condition="Exists('$(ModRootDir)README.md')" />
    </ItemGroup>

    <Copy SourceFiles="@(_StagingAbout)" DestinationFolder="$(CleanStagingDir)About" SkipUnchangedFiles="true" Condition="'@(_StagingAbout)' != ''" />
    <Copy SourceFiles="@(_StagingAssemblies)" DestinationFolder="$(CleanStagingDir)1.7/Assemblies" SkipUnchangedFiles="true" Condition="'@(_StagingAssemblies)' != ''" />
    <Copy SourceFiles="@(_StagingDefs)" DestinationFiles="@(_StagingDefs->'$(CleanStagingDir)1.7/Defs/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingDefs)' != ''" />
    <Copy SourceFiles="@(_StagingPatches)" DestinationFiles="@(_StagingPatches->'$(CleanStagingDir)1.7/Patches/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingPatches)' != ''" />
    <Copy SourceFiles="@(_StagingTextures)" DestinationFiles="@(_StagingTextures->'$(CleanStagingDir)1.7/Textures/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingTextures)' != ''" />
    <Copy SourceFiles="@(_StagingLanguages)" DestinationFiles="@(_StagingLanguages->'$(CleanStagingDir)1.7/Languages/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingLanguages)' != ''" />
    <Copy SourceFiles="@(_StagingDocs)" DestinationFolder="$(CleanStagingDir)" SkipUnchangedFiles="true" Condition="'@(_StagingDocs)' != ''" />

    <!-- Remove rotated staged .old backup immediately if RimWorld is not holding a lock on it -->
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="cmd /c del /f /q &quot;$(CleanStagingDir)1.7\Assemblies\Geoscape.dll.old&quot; 2&gt;nul &amp; exit 0" />
  </Target>

</Project>
