<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================== Persistent Mobile Logistics Hub ==================== -->
  <WorldObjectDef>
    <defName>Vigilance_OrbitalStation</defName>
    <label>orbital logistics hub</label>
    <description>A mobile orbital operational platform and logistics hub. Drifts along an asynchronous planetary orbit, serving as a deployment, command, and maintenance nexus for satellite constellations.</description>
    <worldObjectClass>ProjectVigilance.Geoscape.Orbital.WorldObject_OrbitalStation</worldObjectClass>
    <texture>ProjectVigilance/Geoscape/World/Orbital/OrbitalHub</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>ProjectVigilance/Geoscape/World/Orbital/OrbitalHub</expandingIconTexture>
    <expandingIconPriority>50</expandingIconPriority>
    <fullyExpandedInSpace>true</fullyExpandedInSpace>
    <saved>true</saved>
  </WorldObjectDef>

  <!-- ==================== Reconnaissance Satellite ==================== -->
  <WorldObjectDef>
    <defName>Vigilance_Satellite_Recon</defName>
    <label>reconnaissance satellite</label>
    <description>An autonomous optical and synthetic-aperture radar satellite orbiting on a high-inclination polar track. Sweeps planetary hexes, dispersing the Haze of War and revealing dynamic incursions.</description>
    <worldObjectClass>ProjectVigilance.Geoscape.Orbital.WorldObject_Satellite</worldObjectClass>
    <texture>ProjectVigilance/Geoscape/World/Orbital/Satellite_Recon</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>ProjectVigilance/Geoscape/World/Orbital/Satellite_Recon</expandingIconTexture>
    <expandingIconPriority>48</expandingIconPriority>
    <fullyExpandedInSpace>true</fullyExpandedInSpace>
    <saved>true</saved>
  </WorldObjectDef>

