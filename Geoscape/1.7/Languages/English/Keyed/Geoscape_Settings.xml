  <!-- Palette Overrides & Feature Toggles -->
  <PV_Settings_UseCustomPaletteOverrides>Use Custom Palette Overrides</PV_Settings_UseCustomPaletteOverrides>
  <PV_Settings_UseCustomPaletteOverrides_Desc>Enable granular RGB/HSV sliders for Radar, Identification, and Scout perimeters. When disabled, curated theme presets apply.</PV_Settings_UseCustomPaletteOverrides_Desc>
  <PV_Settings_ThermalIntegrityAudit>Thermal Integrity Def Audit</PV_Settings_ThermalIntegrityAudit>
  <PV_Settings_ThermalIntegrityAudit_Desc>Automatically enforces non-combustible properties on metals, stone, and structural components at startup.</PV_Settings_ThermalIntegrityAudit_Desc>
  <PV_Settings_OptimisticDetours>Optimistic Caravan Detours</PV_Settings_OptimisticDetours>
  <PV_Settings_OptimisticDetours_Desc>Caravans plot paths assuming unmapped fog-of-war sectors are passable, repathing dynamically when impassable terrain is discovered.</PV_Settings_OptimisticDetours_Desc>
  <PV_Settings_InterFactionCollisions>Inter-Faction Overland Collisions</PV_Settings_InterFactionCollisions>
  <PV_Settings_InterFactionCollisions_Desc>Simulates background encounters and skirmishes when rival NPC incursions cross paths on the globe.</PV_Settings_InterFactionCollisions_Desc>
