{
  "name": "project-vigilance",
  "version": "0.3.0",
  "private": true,
  "description": "Modular X-COM conversion and planetary systems suite for RimWorld",
  "scripts": {
    "spellcheck": "npx cspell \"**/*.md\" \"**/*.json\" \"**/*.yml\" \"**/*.cff\"",
    "format": "npx prettier --write \"**/*.{md,json,yml,yaml,cff}\"",
    "build:geoscape": "dotnet build Geoscape/Source/Geoscape.slnx",
    "deploy:geoscape": "pwsh -File ./scripts/deploy-geoscape.ps1",
    "package:release": "pwsh -File ./scripts/package-release.ps1"
  },
  "devDependencies": {
    "cspell": "^10.3.6",
    "prettier": "^3.9.10"
  }
}
