<Project>
  <Target Name="GenerateBuildMetadata" BeforeTargets="BeforeCompile" Condition="'$(MSBuildProjectName)' != 'Geoscape.Tests'">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitBuildNumber" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <_GitDateFmt Condition="$([MSBuild]::IsOSPlatform('Windows'))">%25%25cs</_GitDateFmt>
      <_GitDateFmt Condition="'$(_GitDateFmt)' == ''">%25cs</_GitDateFmt>
    </PropertyGroup>
    <Exec Command="git show -s --format=$(_GitDateFmt) HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitDate" />
    </Exec>
    <Exec Command="git status --porcelain"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatusOutput" />
    </Exec>

    <PropertyGroup>
      <BuildInfoNamespace Condition="'$(MSBuildProjectName)' == 'Geoscape'">ProjectVigilance.Geoscape</BuildInfoNamespace>
      <BuildInfoNamespace Condition="'$(BuildInfoNamespace)' == ''">$(MSBuildProjectName)</BuildInfoNamespace>
      <GitBuildNumber Condition="'$(_GitBuildNumber)' != ''">$(_GitBuildNumber.Trim())</GitBuildNumber>
      <GitBuildNumber Condition="'$(GitBuildNumber)' == ''">0</GitBuildNumber>
      <GitCommitHash Condition="'$(_GitCommitHash)' != ''">$(_GitCommitHash.Trim())</GitCommitHash>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
      <GitCommitDate Condition="'$(_GitCommitDate)' != ''">$(_GitCommitDate.Trim())</GitCommitDate>
      <GitCommitDate Condition="'$(GitCommitDate)' == ''">unknown</GitCommitDate>
      <GitIsDirty Condition="'$(_GitStatusOutput)' != ''">true</GitIsDirty>
      <GitIsDirty Condition="'$(GitIsDirty)' == ''">false</GitIsDirty>
      <BuildInfoFile>$(IntermediateOutputPath)BuildMetadata.g.cs</BuildInfoFile>
    </PropertyGroup>

    <ItemGroup>
      <BuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <BuildInfoLines Include="namespace $(BuildInfoNamespace)%3b" />
      <BuildInfoLines Include="internal static class BuildInfo" />
      <BuildInfoLines Include="{" />
      <BuildInfoLines Include="    public const string Version = &quot;$(Version)&quot;%3b" />
      <BuildInfoLines Include="    public const string BuildNumber = &quot;$(GitBuildNumber)&quot;%3b" />
      <BuildInfoLines Include="    public const string CommitHash = &quot;$(GitCommitHash)&quot;%3b" />
      <BuildInfoLines Include="    public const string CommitDate = &quot;$(GitCommitDate)&quot;%3b" />
      <BuildInfoLines Include="    public const bool IsDirty = $(GitIsDirty)%3b" />
      <BuildInfoLines Include="    public const string Configuration = &quot;$(Configuration)&quot;%3b" />
      <BuildInfoLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <Target Name="RotateLockedAssembly" BeforeTargets="BeforeBuild" Condition="'$(MSBuildProjectName)' != 'Geoscape.Tests'">
    <Delete Files="$(OutputPath)$(TargetName).dll.old;$(OutputPath)$(TargetName).pdb" ContinueOnError="true" />
    <Move SourceFiles="$(OutputPath)$(TargetName).dll"
          DestinationFiles="$(OutputPath)$(TargetName).dll.old"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(OutputPath)$(TargetName).dll')"
          ContinueOnError="true" />
  </Target>

  <Target Name="StageCleanDistribution" AfterTargets="Build" Condition="'$(MSBuildProjectName)' != 'Geoscape.Tests'">
    <PropertyGroup>
      <ModRootDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/../..'))</ModRootDir>
      <ModFolderName>$([System.IO.Path]::GetFileName($([System.IO.Path]::TrimEndingDirectorySeparator('$(ModRootDir)'))))</ModFolderName>
      <CleanStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)dist/ProjectVigilance-$(ModFolderName)'))</CleanStagingDir>
    </PropertyGroup>

    <!-- Clean unlocked .old / Release .pdb files and rotate locked staged DLL if RimWorld is running -->
    <Delete Files="$(OutputPath)$(TargetName).dll.old;$(CleanStagingDir)1.7/Assemblies/$(TargetName).dll.old" ContinueOnError="true" />
    <Delete Files="$(OutputPath)$(TargetName).pdb;$(CleanStagingDir)1.7/Assemblies/$(TargetName).pdb"
            Condition="'$(Configuration)' == 'Release'"
            ContinueOnError="true" />
    <Move SourceFiles="$(CleanStagingDir)1.7/Assemblies/$(TargetName).dll"
          DestinationFiles="$(CleanStagingDir)1.7/Assemblies/$(TargetName).dll.old"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(CleanStagingDir)1.7/Assemblies/$(TargetName).dll')"
          ContinueOnError="true" />

    <!-- Preserve Workshop ID generated/updated in clean staging back into the module source tree -->
    <Copy SourceFiles="$(CleanStagingDir)About/PublishedFileId.txt"
          DestinationFiles="$(ModRootDir)About/PublishedFileId.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CleanStagingDir)About/PublishedFileId.txt')" />

    <ItemGroup>
      <_StagingAbout Include="$(ModRootDir)About/About.xml" Condition="Exists('$(ModRootDir)About/About.xml')" />
      <_StagingAbout Include="$(ModRootDir)About/Preview.png" Condition="Exists('$(ModRootDir)About/Preview.png')" />
      <_StagingAbout Include="$(ModRootDir)About/ModIcon.png" Condition="Exists('$(ModRootDir)About/ModIcon.png')" />
      <_StagingAbout Include="$(ModRootDir)About/PublishedFileId.txt" Condition="Exists('$(ModRootDir)About/PublishedFileId.txt')" />

      <_StagingAssemblies Include="$(OutputPath)$(TargetName).dll" Condition="Exists('$(OutputPath)$(TargetName).dll')" />
      <_StagingAssemblies Include="$(OutputPath)$(TargetName).pdb" Condition="'$(Configuration)' != 'Release' and Exists('$(OutputPath)$(TargetName).pdb')" />

      <_StagingDefs Include="$(ModRootDir)1.7/Defs/**/*" Condition="Exists('$(ModRootDir)1.7/Defs')" />
      <_StagingPatches Include="$(ModRootDir)1.7/Patches/**/*" Condition="Exists('$(ModRootDir)1.7/Patches')" />
      <_StagingTextures Include="$(ModRootDir)1.7/Textures/**/*" Condition="Exists('$(ModRootDir)1.7/Textures')" />
      <_StagingLanguages Include="$(ModRootDir)1.7/Languages/**/*" Condition="Exists('$(ModRootDir)1.7/Languages')" />
      <_StagingSounds Include="$(ModRootDir)1.7/Sounds/**/*" Condition="Exists('$(ModRootDir)1.7/Sounds')" />

      <_StagingDocs Include="$(MSBuildThisFileDirectory)LICENSE" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
      <_StagingDocs Include="$(ModRootDir)README.md" Condition="Exists('$(ModRootDir)README.md')" />
      <_StagingRootFiles Include="$(ModRootDir)LoadFolders.xml" Condition="Exists('$(ModRootDir)LoadFolders.xml')" />
    </ItemGroup>

    <Copy SourceFiles="@(_StagingAbout)" DestinationFolder="$(CleanStagingDir)About" SkipUnchangedFiles="true" Condition="'@(_StagingAbout)' != ''" />
    <Copy SourceFiles="@(_StagingAssemblies)" DestinationFolder="$(CleanStagingDir)1.7/Assemblies" SkipUnchangedFiles="true" Condition="'@(_StagingAssemblies)' != ''" />
    <Copy SourceFiles="@(_StagingDefs)" DestinationFiles="@(_StagingDefs->'$(CleanStagingDir)1.7/Defs/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingDefs)' != ''" />
    <Copy SourceFiles="@(_StagingPatches)" DestinationFiles="@(_StagingPatches->'$(CleanStagingDir)1.7/Patches/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingPatches)' != ''" />
    <Copy SourceFiles="@(_StagingTextures)" DestinationFiles="@(_StagingTextures->'$(CleanStagingDir)1.7/Textures/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingTextures)' != ''" />
    <Copy SourceFiles="@(_StagingLanguages)" DestinationFiles="@(_StagingLanguages->'$(CleanStagingDir)1.7/Languages/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingLanguages)' != ''" />
    <Copy SourceFiles="@(_StagingSounds)" DestinationFiles="@(_StagingSounds->'$(CleanStagingDir)1.7/Sounds/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_StagingSounds)' != ''" />
    <Copy SourceFiles="@(_StagingDocs)" DestinationFolder="$(CleanStagingDir)" SkipUnchangedFiles="true" Condition="'@(_StagingDocs)' != ''" />
    <Copy SourceFiles="@(_StagingRootFiles)" DestinationFolder="$(CleanStagingDir)" SkipUnchangedFiles="true" Condition="'@(_StagingRootFiles)' != ''" />

    <!-- Sync EmbeddedCore fallback payload inside Geoscape staging for LoadFolders.xml IfModNotActive="ProjectVigilance.Core" -->
    <PropertyGroup Condition="'$(ModFolderName)' == 'Geoscape'">
      <CoreModuleDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)Core'))</CoreModuleDir>
      <EmbeddedCoreDir>$([MSBuild]::NormalizeDirectory('$(CleanStagingDir)1.7/EmbeddedCore'))</EmbeddedCoreDir>
    </PropertyGroup>
    <Delete Files="$(EmbeddedCoreDir)Assemblies/ProjectVigilance.Core.dll.old;$(EmbeddedCoreDir)Assemblies/ProjectVigilance.Core.pdb"
            Condition="'$(ModFolderName)' == 'Geoscape'"
            ContinueOnError="true" />
    <Move SourceFiles="$(EmbeddedCoreDir)Assemblies/ProjectVigilance.Core.dll"
          DestinationFiles="$(EmbeddedCoreDir)Assemblies/ProjectVigilance.Core.dll.old"
          OverwriteReadOnlyFiles="true"
          Condition="'$(ModFolderName)' == 'Geoscape' and Exists('$(EmbeddedCoreDir)Assemblies/ProjectVigilance.Core.dll')"
          ContinueOnError="true" />

    <ItemGroup Condition="'$(ModFolderName)' == 'Geoscape'">
      <_EmbeddedCoreAssembly Include="$(CoreModuleDir)1.7/Assemblies/ProjectVigilance.Core.dll" Condition="Exists('$(CoreModuleDir)1.7/Assemblies/ProjectVigilance.Core.dll')" />
      <_EmbeddedCoreDefs Include="$(CoreModuleDir)1.7/Defs/**/*" Condition="Exists('$(CoreModuleDir)1.7/Defs')" />
      <_EmbeddedCoreLanguages Include="$(CoreModuleDir)1.7/Languages/**/*" Condition="Exists('$(CoreModuleDir)1.7/Languages')" />
    </ItemGroup>
    <Copy SourceFiles="@(_EmbeddedCoreAssembly)" DestinationFolder="$(EmbeddedCoreDir)Assemblies" SkipUnchangedFiles="true" Condition="'$(ModFolderName)' == 'Geoscape' and '@(_EmbeddedCoreAssembly)' != ''" />
    <Copy SourceFiles="@(_EmbeddedCoreDefs)" DestinationFiles="@(_EmbeddedCoreDefs->'$(EmbeddedCoreDir)Defs/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(ModFolderName)' == 'Geoscape' and '@(_EmbeddedCoreDefs)' != ''" />
    <Copy SourceFiles="@(_EmbeddedCoreLanguages)" DestinationFiles="@(_EmbeddedCoreLanguages->'$(EmbeddedCoreDir)Languages/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(ModFolderName)' == 'Geoscape' and '@(_EmbeddedCoreLanguages)' != ''" />
    <Delete Files="$(EmbeddedCoreDir)Assemblies/ProjectVigilance.Core.dll.old"
            Condition="'$(ModFolderName)' == 'Geoscape'"
            ContinueOnError="true" />

    <!-- Remove rotated staged .old backup immediately if RimWorld is not holding a lock on it -->
    <Delete Files="$(CleanStagingDir)1.7/Assemblies/$(TargetName).dll.old" ContinueOnError="true" />
  </Target>
</Project>
