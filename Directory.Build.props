<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!-- Strip .pdb symbol files from Release mod distributions while preserving test stack traces -->
    <GenerateDependencyFile Condition="'$(MSBuildProjectName)' != 'Geoscape.Tests'">false</GenerateDependencyFile>
    <DebugType Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectName)' != 'Geoscape.Tests'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectName)' != 'Geoscape.Tests'">false</DebugSymbols>
    <_ExplicitRimWorldPathProvided Condition="'$(RimWorldPath)' != ''">true</_ExplicitRimWorldPathProvided>
    <_ExplicitHarmonyPathProvided Condition="'$(HarmonyPath)' != ''">true</_ExplicitHarmonyPathProvided>
    <_RepoRefDir>$(MSBuildThisFileDirectory)lib/ref</_RepoRefDir>
    <!-- Default Steam paths by platform (used for test execution or explicit opt-in) -->
    <RimWorldPath Condition="'$(RimWorldPath)' == '' and '$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))'">D:\Games\Steam\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;)) and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/RimWorld')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))">$(HOME)/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and '$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))'">D:\Games\Steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;)) and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and !$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
    <!-- Production mod builds prefer deterministic repo ref stubs unless RimWorldPath/HarmonyPath was explicitly provided;
         Geoscape.Tests executes runtime bytecode so it resolves the local RimWorld install first with lib/ref fallback. -->
    <RimWorldResolvedPath Condition="'$(_ExplicitRimWorldPathProvided)' == 'true' and Exists('$(RimWorldPath)/Assembly-CSharp.dll')">$(RimWorldPath)</RimWorldResolvedPath>
    <RimWorldResolvedPath Condition="'$(RimWorldResolvedPath)' == '' and '$(MSBuildProjectName)' != 'Geoscape.Tests' and Exists('$(_RepoRefDir)/Assembly-CSharp.dll')">$(_RepoRefDir)</RimWorldResolvedPath>
    <RimWorldResolvedPath Condition="'$(RimWorldResolvedPath)' == '' and Exists('$(RimWorldPath)/Assembly-CSharp.dll')">$(RimWorldPath)</RimWorldResolvedPath>
    <RimWorldResolvedPath Condition="'$(RimWorldResolvedPath)' == '' and Exists('$(_RepoRefDir)/Assembly-CSharp.dll')">$(_RepoRefDir)</RimWorldResolvedPath>
    <RimWorldResolvedPath Condition="'$(RimWorldResolvedPath)' == ''">$(RimWorldPath)</RimWorldResolvedPath>
    <HarmonyResolvedPath Condition="'$(_ExplicitHarmonyPathProvided)' == 'true' and Exists('$(HarmonyPath)')">$(HarmonyPath)</HarmonyResolvedPath>
    <HarmonyResolvedPath Condition="'$(HarmonyResolvedPath)' == '' and '$(MSBuildProjectName)' != 'Geoscape.Tests' and Exists('$(_RepoRefDir)/0Harmony.dll')">$(_RepoRefDir)/0Harmony.dll</HarmonyResolvedPath>
    <HarmonyResolvedPath Condition="'$(HarmonyResolvedPath)' == '' and Exists('$(HarmonyPath)')">$(HarmonyPath)</HarmonyResolvedPath>
    <HarmonyResolvedPath Condition="'$(HarmonyResolvedPath)' == '' and Exists('$(_RepoRefDir)/0Harmony.dll')">$(_RepoRefDir)/0Harmony.dll</HarmonyResolvedPath>
    <HarmonyResolvedPath Condition="'$(HarmonyResolvedPath)' == ''">$(HarmonyPath)</HarmonyResolvedPath>
    <_CopyRefAssemblies>false</_CopyRefAssemblies>
    <_CopyRefAssemblies Condition="'$(MSBuildProjectName)' == 'Geoscape.Tests'">true</_CopyRefAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" Condition="'$(MSBuildProjectName)' != 'ProjectVigilance.Aquatics' and '$(MSBuildProjectName)' != 'ProjectVigilance.Thermal'">
      <HintPath>$(HarmonyResolvedPath)</HintPath>
      <Private>$(_CopyRefAssemblies)</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldResolvedPath)/Assembly-CSharp.dll</HintPath>
      <Private>$(_CopyRefAssemblies)</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(RimWorldResolvedPath)/RimWorld.dll</HintPath>
      <Private>$(_CopyRefAssemblies)</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldResolvedPath)/UnityStubs.dll</HintPath>
      <Private>$(_CopyRefAssemblies)</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldResolvedPath)/Waylith.UnityCompat.dll</HintPath>
      <Private>$(_CopyRefAssemblies)</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(RimWorldResolvedPath)/CommunityToolkit.HighPerformance.dll</HintPath>
      <Private>$(_CopyRefAssemblies)</Private>
    </Reference>
  </ItemGroup>
</Project>